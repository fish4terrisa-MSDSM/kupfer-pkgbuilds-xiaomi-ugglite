build() {
    cd "$srcdir"/lk2nd
    rm -rf build-lk2nd-*
    #for target in $_targets; do
    target=$_targets
        make TOOLCHAIN_PREFIX=arm-none-eabi- "lk2nd-msm8937";
    #done
}

_package() {
    local target=${1%%-git}
    pkgdesc="lk2nd for ${target##lk2nd-} platform"
    provides+=("$target")
    install -Dm644 "$srcdir/lk2nd/build-msm8937/lk2nd.img" "${pkgdir}"/boot/lk2nd.img
}

for p in "${pkgname[@]}"; do
    eval "package_${p}() {
    _package ${p##boot-}
  }"
done

    armv7
)
license=(MIT)
url=https://github.com/msm8916-mainline/lk2nd
provides=(boot-lk2nd)
makedepends=(
    python
    dtc
    arm-none-eabi-gcc
)
_commit=b9c007bb549229da15e9b2b35f19f82fa4d07967
source=("git+$url#commit=$_commit")
sha256sums=(SKIP)

_targets="msm8917"
pkgname=()
pkgname+=("${pkgbase%-git}-$_targets-git")


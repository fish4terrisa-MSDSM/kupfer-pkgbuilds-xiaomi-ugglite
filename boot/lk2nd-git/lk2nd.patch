@@ -75,12 +75,15 @@
 
 			qcom,mdss_dsi_tm_otm1901a_720p_video {
 				compatible = "xiaomi,ugglite-otm1901a-tm";
+				touchscreen-compatible = "goodix,gt917d";
 			};
 			qcom,mdss_dsi_sc_ili9881c_720p_video {
 				compatible = "xiaomi,ugglite-ili9881c-sc";
